# Example environment for Shiro Screen Share (copy to .env and edit values)
# These keys are used by the app at runtime and by the build where applicable.

# URL do backend (token generator / API)
BACKEND_URL=https://your-backend.example.com/

# URL do servidor LiveKit (wss://...)
LIVEKIT_URL=wss://livekit.example.com

# Discord application client ID (use your OAuth app's client id)
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID

# Optional flags
#ENABLE_TELEMETRY=false

# Notes:
# - Never commit real secrets to version control. Keep the real .env private.
# - If you have additional build-specific variables, add them here so the project
#   documentation and example stay in sync.
